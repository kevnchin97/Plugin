{
	Tools = ordered() {
		PFXZoomThrough = GroupOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "PFXZoomThrough_Xf", Source = "Input", },
				Input1 = InstanceInput {
					SourceOp = "PFXZoomThrough_Ctl",
					Source = "NumberIn2",
					Name = "Zoom",
					Default = 1.2,
					MinScale = -2,
					MaxScale = 2,
				},
				Input2 = InstanceInput {
					SourceOp = "PFXZoomThrough_Ctl",
					Source = "NumberIn3",
					Name = "Blur",
					Default = 0.6,
					MinScale = 0,
					MaxScale = 1,
				},
				Input3 = InstanceInput { SourceOp = "PFXZoomThrough_Xf", Source = "Pivot", Name = "Zoom Centre", },
				Input4 = InstanceInput { SourceOp = "PFXZoomThrough_Progress", Source = "Curve", Name = "Curve", },
				Input5 = InstanceInput { SourceOp = "PFXZoomThrough_Progress", Source = "EaseIn", Name = "Ease In", },
				Input6 = InstanceInput { SourceOp = "PFXZoomThrough_Progress", Source = "EaseOut", Name = "Ease Out", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "PFXZoomThrough_ZoomBlur", Source = "Output", },
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0 },
			},
			Tools = ordered() {
				PFXZoomThrough_Ctl = Custom {
					CtrlWZoom = false,
					UserControls = ordered() { },
					Inputs = {
						NumberIn1 = Input { SourceOp = "PFXZoomThrough_Progress", Source = "Value", },
						NameforNumber1 = Input { Value = "Progress", },
						NumberIn2 = Input { Value = 1.2, },
						NameforNumber2 = Input { Value = "Zoom", },
						NumberIn3 = Input { Value = 0.6, },
						NameforNumber3 = Input { Value = "Blur", },
					},
					ViewInfo = OperatorInfo {
						Pos = { 0, 0 },
					},
				},
				PFXZoomThrough_ProgressLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = {
								0,
								RH = { 0.3333333333, 0.3333333333 },
								Flags = { Linear = true, },
							},
							[1] = {
								1,
								LH = { 0.6666666667, 0.6666666667 },
								Flags = { Linear = true, },
							},
						},
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255, },
				},
				PFXZoomThrough_Progress = LUTLookup {
					Inputs = {
						Source = Input {
							Value = FuID { "Duration" },
						},
						Curve = Input {
							Value = FuID { "Easing" },
						},
						EaseIn = Input {
							Value = FuID { "Quint" },
						},
						EaseOut = Input {
							Value = FuID { "Quint" },
						},
						Lookup = Input { SourceOp = "PFXZoomThrough_ProgressLookup", Source = "Value", },
					},
				},
				PFXZoomThrough_Xf = Transform {
					CtrlWZoom = false,
					Inputs = {
						Size = Input {
							Expression = "2^(PFXZoomThrough_Ctl.NumberIn2*(2*PFXZoomThrough_Ctl.NumberIn1 - iif(PFXZoomThrough_Ctl.NumberIn1 < 0.5, 0, 2)))",
						},
						Pivot = Input {
							Value = { 0.5, 0.5 },
						},
						Edges = Input { Value = 3, },
					},
					ViewInfo = OperatorInfo {
						Pos = { 110, 0 },
					},
				},
				PFXZoomThrough_ZoomBlur = DirectionalBlur {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "PFXZoomThrough_Xf", Source = "Output", },
						Type = Input { Value = 3, },
						Center = Input { Expression = "PFXZoomThrough_Xf.Pivot", },
						Length = Input {
							Expression = "PFXZoomThrough_Ctl.NumberIn3*0.4*(4*PFXZoomThrough_Ctl.NumberIn1*(1 - PFXZoomThrough_Ctl.NumberIn1))",
						},
					},
					ViewInfo = OperatorInfo {
						Pos = { 220, 0 },
					},
				},
			},
		},
	},
	ActiveTool = "PFXZoomThrough",
}
