{
	Tools = ordered() {
		PFXSpin = GroupOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "PFXSpin_Xf", Source = "Input", },
				Input1 = InstanceInput {
					SourceOp = "PFXSpin_Ctl",
					Source = "NumberIn2",
					Name = "Rotations",
					Default = 1,
					MinScale = -3,
					MaxScale = 3,
				},
				Input2 = InstanceInput {
					SourceOp = "PFXSpin_Ctl",
					Source = "NumberIn3",
					Name = "Zoom",
					Default = 0.3,
					MinScale = 0,
					MaxScale = 1,
				},
				Input3 = InstanceInput {
					SourceOp = "PFXSpin_Ctl",
					Source = "NumberIn4",
					Name = "Blur",
					Default = 0.6,
					MinScale = 0,
					MaxScale = 1,
				},
				Input4 = InstanceInput { SourceOp = "PFXSpin_Progress", Source = "Curve", Name = "Curve", },
				Input5 = InstanceInput { SourceOp = "PFXSpin_Progress", Source = "EaseIn", Name = "Ease In", },
				Input6 = InstanceInput { SourceOp = "PFXSpin_Progress", Source = "EaseOut", Name = "Ease Out", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "PFXSpin_Xf", Source = "Output", },
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0 },
			},
			Tools = ordered() {
				PFXSpin_Ctl = Custom {
					CtrlWZoom = false,
					UserControls = ordered() { },
					Inputs = {
						NumberIn1 = Input { SourceOp = "PFXSpin_Progress", Source = "Value", },
						NameforNumber1 = Input { Value = "Progress", },
						NumberIn2 = Input { Value = 1, },
						NameforNumber2 = Input { Value = "Rotations", },
						NumberIn3 = Input { Value = 0.3, },
						NameforNumber3 = Input { Value = "Zoom", },
						NumberIn4 = Input { Value = 0.6, },
						NameforNumber4 = Input { Value = "Blur", },
					},
					ViewInfo = OperatorInfo {
						Pos = { 0, 0 },
					},
				},
				PFXSpin_ProgressLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = {
								0,
								RH = { 0.3333333333, 0.3333333333 },
								Flags = { Linear = true, },
							},
							[1] = {
								1,
								LH = { 0.6666666667, 0.6666666667 },
								Flags = { Linear = true, },
							},
						},
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255, },
				},
				PFXSpin_Progress = LUTLookup {
					Inputs = {
						Source = Input {
							Value = FuID { "Duration" },
						},
						Curve = Input {
							Value = FuID { "Easing" },
						},
						EaseIn = Input {
							Value = FuID { "Quint" },
						},
						EaseOut = Input {
							Value = FuID { "Quint" },
						},
						Lookup = Input { SourceOp = "PFXSpin_ProgressLookup", Source = "Value", },
					},
				},
				PFXSpin_Xf = Transform {
					CtrlWZoom = false,
					Inputs = {
						Angle = Input {
							Expression = "360*iif(abs(floor(PFXSpin_Ctl.NumberIn2 + 0.5)) < 1, 1, floor(PFXSpin_Ctl.NumberIn2 + 0.5))*PFXSpin_Ctl.NumberIn1",
						},
						Size = Input { Expression = "1 + PFXSpin_Ctl.NumberIn3*(4*PFXSpin_Ctl.NumberIn1*(1 - PFXSpin_Ctl.NumberIn1))", },
						Edges = Input { Value = 3, },
						MotionBlur = Input { Value = 1, },
						Quality = Input { Value = 10, },
						ShutterAngle = Input { Expression = "360*PFXSpin_Ctl.NumberIn4", },
					},
					ViewInfo = OperatorInfo {
						Pos = { 110, 0 },
					},
				},
			},
		},
	},
	ActiveTool = "PFXSpin",
}
