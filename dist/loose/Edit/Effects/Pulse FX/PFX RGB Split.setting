{
	Tools = ordered() {
		PFXRGBSplit = GroupOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "PFXRGBSplit_Red", Source = "Input", },
				Input1 = InstanceInput {
					SourceOp = "PFXRGBSplit_Ctl",
					Source = "NumberIn2",
					Name = "Amount",
					Default = 0.3,
					MinScale = 0,
					MaxScale = 1,
				},
				Input2 = InstanceInput {
					SourceOp = "PFXRGBSplit_Ctl",
					Source = "NumberIn3",
					Name = "Angle",
					Default = 0,
					MinScale = -180,
					MaxScale = 180,
				},
				Input3 = InstanceInput {
					SourceOp = "PFXRGBSplit_Ctl",
					Source = "NumberIn4",
					Name = "Jitter",
					Default = 0,
					MinScale = 0,
					MaxScale = 1,
				},
				Input4 = InstanceInput { SourceOp = "PFXRGBSplit_Ctl", Source = "NumberIn5", Name = "Envelope", Default = 3, },
				Input5 = InstanceInput { SourceOp = "PFXRGBSplit_Progress", Source = "Curve", Name = "Curve", },
				Input6 = InstanceInput { SourceOp = "PFXRGBSplit_Progress", Source = "EaseIn", Name = "Ease In", },
				Input7 = InstanceInput { SourceOp = "PFXRGBSplit_Progress", Source = "EaseOut", Name = "Ease Out", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "PFXRGBSplit_Blue", Source = "Output", },
			},
			ViewInfo = GroupInfo {
				Pos = { 0, 0 },
			},
			Tools = ordered() {
				PFXRGBSplit_Ctl = Custom {
					CtrlWZoom = false,
					UserControls = ordered() {
						NumberIn5 = {
							{ CCS_AddString = "Hit (fade out)", },
							{ CCS_AddString = "Build (fade in)", },
							{ CCS_AddString = "Pulse (peak mid-clip)", },
							{ CCS_AddString = "Constant", },
							LINKS_Name = "Envelope",
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							CC_LabelPosition = "Horizontal",
							INP_Integer = false,
							INP_Default = 3,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_MinAllowed = 0,
							INP_MaxAllowed = 3,
							ICS_ControlPage = "Controls",
						},
					},
					Inputs = {
						NumberIn1 = Input { SourceOp = "PFXRGBSplit_Progress", Source = "Value", },
						NameforNumber1 = Input { Value = "Progress", },
						NumberIn2 = Input { Value = 0.3, },
						NameforNumber2 = Input { Value = "Amount", },
						NumberIn3 = Input { Value = 0, },
						NameforNumber3 = Input { Value = "Angle", },
						NumberIn4 = Input { Value = 0, },
						NameforNumber4 = Input { Value = "Jitter", },
						NumberIn5 = Input { Value = 3, },
						NameforNumber5 = Input { Value = "Envelope", },
					},
					ViewInfo = OperatorInfo {
						Pos = { 0, 0 },
					},
				},
				PFXRGBSplit_ProgressLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = {
								0,
								RH = { 0.3333333333, 0.3333333333 },
								Flags = { Linear = true, },
							},
							[1] = {
								1,
								LH = { 0.6666666667, 0.6666666667 },
								Flags = { Linear = true, },
							},
						},
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255, },
				},
				PFXRGBSplit_Progress = LUTLookup {
					Inputs = {
						Source = Input {
							Value = FuID { "Duration" },
						},
						Curve = Input {
							Value = FuID { "Easing" },
						},
						EaseIn = Input {
							Value = FuID { "Sine" },
						},
						EaseOut = Input {
							Value = FuID { "Sine" },
						},
						Lookup = Input { SourceOp = "PFXRGBSplit_ProgressLookup", Source = "Value", },
					},
				},
				PFXRGBSplit_Red = Transform {
					CtrlWZoom = false,
					Inputs = {
						Center = Input {
							Expression = "Point(0.5 + (PFXRGBSplit_Ctl.NumberIn2*0.03*(iif(PFXRGBSplit_Ctl.NumberIn5 == 0, 1 - PFXRGBSplit_Ctl.NumberIn1, iif(PFXRGBSplit_Ctl.NumberIn5 == 1, PFXRGBSplit_Ctl.NumberIn1, iif(PFXRGBSplit_Ctl.NumberIn5 == 2, 4*PFXRGBSplit_Ctl.NumberIn1*(1 - PFXRGBSplit_Ctl.NumberIn1), 1))))*(1 + PFXRGBSplit_Ctl.NumberIn4*(2*((sin((floor(time))*12.9898)*43758.5453) % 1) - 1)))*cos(PFXRGBSplit_Ctl.NumberIn3*pi/180), 0.5 + (PFXRGBSplit_Ctl.NumberIn2*0.03*(iif(PFXRGBSplit_Ctl.NumberIn5 == 0, 1 - PFXRGBSplit_Ctl.NumberIn1, iif(PFXRGBSplit_Ctl.NumberIn5 == 1, PFXRGBSplit_Ctl.NumberIn1, iif(PFXRGBSplit_Ctl.NumberIn5 == 2, 4*PFXRGBSplit_Ctl.NumberIn1*(1 - PFXRGBSplit_Ctl.NumberIn1), 1))))*(1 + PFXRGBSplit_Ctl.NumberIn4*(2*((sin((floor(time))*12.9898)*43758.5453) % 1) - 1)))*1.78*sin(PFXRGBSplit_Ctl.NumberIn3*pi/180))",
						},
						Edges = Input { Value = 3, },
						ProcessGreen = Input { Value = 0, },
						ProcessBlue = Input { Value = 0, },
						ProcessAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo {
						Pos = { 110, 0 },
					},
				},
				PFXRGBSplit_Blue = Transform {
					CtrlWZoom = false,
					Inputs = {
						Input = Input { SourceOp = "PFXRGBSplit_Red", Source = "Output", },
						Center = Input {
							Expression = "Point(0.5 - (PFXRGBSplit_Ctl.NumberIn2*0.03*(iif(PFXRGBSplit_Ctl.NumberIn5 == 0, 1 - PFXRGBSplit_Ctl.NumberIn1, iif(PFXRGBSplit_Ctl.NumberIn5 == 1, PFXRGBSplit_Ctl.NumberIn1, iif(PFXRGBSplit_Ctl.NumberIn5 == 2, 4*PFXRGBSplit_Ctl.NumberIn1*(1 - PFXRGBSplit_Ctl.NumberIn1), 1))))*(1 + PFXRGBSplit_Ctl.NumberIn4*(2*((sin((floor(time))*12.9898)*43758.5453) % 1) - 1)))*cos(PFXRGBSplit_Ctl.NumberIn3*pi/180), 0.5 - (PFXRGBSplit_Ctl.NumberIn2*0.03*(iif(PFXRGBSplit_Ctl.NumberIn5 == 0, 1 - PFXRGBSplit_Ctl.NumberIn1, iif(PFXRGBSplit_Ctl.NumberIn5 == 1, PFXRGBSplit_Ctl.NumberIn1, iif(PFXRGBSplit_Ctl.NumberIn5 == 2, 4*PFXRGBSplit_Ctl.NumberIn1*(1 - PFXRGBSplit_Ctl.NumberIn1), 1))))*(1 + PFXRGBSplit_Ctl.NumberIn4*(2*((sin((floor(time))*12.9898)*43758.5453) % 1) - 1)))*1.78*sin(PFXRGBSplit_Ctl.NumberIn3*pi/180))",
						},
						Edges = Input { Value = 3, },
						ProcessRed = Input { Value = 0, },
						ProcessGreen = Input { Value = 0, },
						ProcessAlpha = Input { Value = 0, },
					},
					ViewInfo = OperatorInfo {
						Pos = { 220, 0 },
					},
				},
			},
		},
	},
	ActiveTool = "PFXRGBSplit",
}
