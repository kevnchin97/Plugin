{
  "name": "@innovate/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./workers": "./src/workers.ts"
  },
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 tsx watch --clear-screen=false src/main.ts",
    "start": "NODE_USE_ENV_PROXY=1 tsx src/main.ts",
    "seed:media": "NODE_USE_ENV_PROXY=1 tsx src/seed-media.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "NODE_USE_ENV_PROXY=1 vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@innovate/db": "workspace:*",
    "@innovate/media": "workspace:*",
    "@innovate/shared": "workspace:*",
    "@xenova/transformers": "2.17.2",
    "bullmq": "5.81.5",
    "dotenv": "17.2.3",
    "pdfkit": "0.17.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.3",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
