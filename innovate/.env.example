# Copy to .env (`cp .env.example .env`). Every variable the apps read is listed here.
# Defaults match docker-compose.yml. Never commit .env.

# --- Postgres 16 + pgvector ---
DATABASE_URL=postgres://innovate:innovate@localhost:5432/innovate
DATABASE_POOL_MAX=10

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible storage (MinIO locally) ---
# Endpoint the web app and worker use.
S3_ENDPOINT=http://localhost:9000
# Endpoint browsers use for signed URLs (a CDN or public S3 host in production).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=innovate-media
S3_ACCESS_KEY_ID=innovate
S3_SECRET_ACCESS_KEY=innovate-secret
S3_FORCE_PATH_STYLE=true
# Lifetime of signed GET/PUT URLs for private media.
SIGNED_URL_TTL_SECONDS=3600

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Google sign-in is enabled only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# SMTP for magic links in production, e.g. smtp://user:pass@smtp.example.com:587
# When empty, magic links are printed to the web server console instead.
EMAIL_SERVER=
EMAIL_FROM=Innovate <login@localhost>
# Optional: also append dev magic links to this file (used by the Playwright tests).
MAGIC_LINK_LOG_FILE=

# --- Realtime (apps/realtime: WebSockets for comments, presence, live board edits) ---
REALTIME_PORT=3001
# What browsers connect to (wss://… behind TLS in production).
REALTIME_PUBLIC_URL=ws://localhost:3001

# --- Notifications ---
# Dev only: also append outgoing emails here (the e2e tests read it). Empty = console only.
MAIL_LOG_FILE=

# --- Worker ---
WORKER_CONCURRENCY=2
# Scratch space for ffmpeg; originals are cached here between exports.
WORKER_TMP_DIR=.data/worker
# Ingest decodes long videos in this many parallel chunks (empty = CPU count).
INGEST_PARALLELISM=
# Direct-URL ingest: largest download accepted, and whether private/loopback hosts are allowed.
INGEST_MAX_BYTES=4294967296
INGEST_ALLOW_PRIVATE_URLS=false

# --- Platform ingest adapters (see docs/ADAPTERS.md; all off by default) ---
# Vimeo, via its official API: imports videos the token's account is allowed to download.
INGEST_VIMEO_ENABLED=false
# Personal access token with scopes: public private video_files.
VIMEO_ACCESS_TOKEN=
# Override only for tests (points at a local fake of the API).
VIMEO_API_BASE=

# --- Tests only ---
# Lets a production build print magic links (Playwright runs `next start`). Never set in production.
INNOVATE_E2E=
