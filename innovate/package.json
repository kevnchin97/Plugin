{
  "name": "innovate",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "pnpm --filter @innovate/web e2e",
    "e2e:desktop": "E2E_DESKTOP=1 pnpm --filter @innovate/web e2e",
    "fixtures": "pnpm --filter @innovate/media fixtures",
    "tokens": "pnpm --filter @innovate/shared tokens",
    "db:generate": "pnpm --filter @innovate/db generate",
    "db:migrate": "pnpm --filter @innovate/db migrate",
    "db:seed": "pnpm --filter @innovate/db seed",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "msgpackr-extract", "unrs-resolver"]
  }
}
